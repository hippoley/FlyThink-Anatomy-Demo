{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://flythink.dev/contracts/benchmark-hidden-input-pack.v1.schema.json",
  "title":"FlyThink Hidden Benchmark Input Pack v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","pack_id","language","source","cases"],
  "properties":{
    "schema_version":{"const":"benchmark-hidden-input-pack.v1"},
    "pack_id":{"type":"string","minLength":1},
    "language":{"type":"string","minLength":2},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["kind","producer_id","generation_system","independent_of_flythink_generator"],
      "properties":{
        "kind":{"enum":["human","independent_generator","external_dataset","fixture"]},
        "producer_id":{"type":"string","minLength":1},
        "generation_system":{"type":"string","minLength":1},
        "independent_of_flythink_generator":{"type":"boolean"},
        "license":{"type":["string","null"]},
        "upstream_revision":{"type":["string","null"]}
      }
    },
    "cases":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["case_id","text","initial_runtime","context_seed"],
        "properties":{
          "case_id":{"type":"string","minLength":1},
          "text":{"type":"string","minLength":1},
          "initial_runtime":{"type":"object"},
          "context_seed":{"type":"object"}
        }
      }
    }
  }
}

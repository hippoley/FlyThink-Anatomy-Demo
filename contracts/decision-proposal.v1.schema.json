{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/FlyThink-Anatomy-Demo/contracts/decision-proposal.v1.schema.json",
  "title": "FlyThink DecisionProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "task_id",
    "context_revision",
    "world_snapshot_revision",
    "world_snapshot_sha256",
    "intent",
    "logical_targets",
    "proposed_mutations",
    "confidence",
    "requires_confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": "decision-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context_revision": {
      "type": "integer",
      "minimum": 0
    },
    "world_snapshot_revision": {
      "type": "integer",
      "minimum": 0
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "logical_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/logicalTarget"
      }
    },
    "proposed_mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mutation"
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "world_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "logicalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "entity",
        "instance"
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "property",
        "operator",
        "value"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/logicalTarget"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "SET",
            "ADD"
          ]
        },
        "value": {}
      }
    }
  }
}

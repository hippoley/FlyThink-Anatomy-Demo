{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://flythink.dev/contracts/benchmark-hidden-prediction-pack.v1.schema.json",
  "title":"FlyThink Hidden Benchmark Prediction Pack v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","pack_id","input_pack_sha256","producer","predictions"],
  "properties":{
    "schema_version":{"const":"benchmark-hidden-prediction-pack.v1"},
    "pack_id":{"type":"string","minLength":1},
    "input_pack_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "producer":{"type":"object"},
    "predictions":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["case_id","decision","patches"],
        "properties":{
          "case_id":{"type":"string","minLength":1},
          "decision":{"type":"string","minLength":1},
          "patches":{"type":"array","items":{"type":"object"}}
        }
      }
    }
  }
}

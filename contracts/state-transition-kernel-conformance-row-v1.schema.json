{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/FlyThink-Anatomy-Demo/contracts/state-transition-kernel-conformance-row-v1.schema.json",
  "title": "State-transition kernel conformance row v1",
  "type": "object",
  "required": ["id", "confidence", "exact"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "exact": {"type": "boolean"},
    "wrong_target": {"type": "boolean"},
    "untouched_state_corruption": {"type": "boolean"},
    "ood_false_commit": {"type": "boolean"},
    "family": {"type": "string"},
    "model": {"type": "string"},
    "case_digest": {"type": "string"}
  }
}